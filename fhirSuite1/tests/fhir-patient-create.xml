<?xml version="1.0" encoding="UTF-8"?>
<testcase id="fhir-patient-create"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">

  <metadata>
    <gitb:name>[FHIR-TC1] Patient Create Forwarding</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>
      Receives a Patient resource from the SUT, forwards it to a live FHIR server,
      and validates that a 201 response is returned. Uses a default payload if SUT did not provide one.
    </gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="FHIRClient" role="SUT"/>
  </actors>

  <variables>
    <var name="fhirBaseUrl" type="string">
      <value>https://hapi.fhir.org/baseR4</value>
    </var>

    <var name="defaultPatientPayload" type="string">
      <value>{"resourceType":"Patient","id":"example","name":[{"family":"Doe","given":["John"]}],"gender":"male","birthDate":"2000-01-01"}</value>
    </var>

    <var name="patientPayload" type="string"/>
  </variables>

  <steps>
    <!-- 1) Receive Patient resource from SUT -->
    <receive id="sut_request" from="FHIRClient" desc="Receive Patient Create request">
      <input name="requestPayload"/>
    </receive>

    <!-- 2) Assign payload: use SUT payload if provided, else default -->
    <assign to="patientPayload">
      if (exists($sut_request{requestPayload}) and string-length(normalize-space($sut_request{requestPayload})) > 0)
      then $sut_request{requestPayload}
      else $defaultPatientPayload
    </assign>

    <!-- 3) Forward to FHIR server -->
    <assign to="headers{Content-Type}">"application/fhir+json"</assign>
    <assign to="headers{Accept}">"application/fhir+json"</assign>

    <send id="forward_to_fhir" desc="Forward Patient Create to FHIR Server" handler="HttpMessagingV2" from="FHIRClient" to="FHIRClient">
      <input name="uri">$fhirBaseUrl/Patient</input>
      <input name="method">POST</input>
      <input name="headers">$headers</input>
      <input name="body">$patientPayload</input>
    </send>

    <!-- 4) Verify HTTP 201 response -->
    <verify handler="NumberValidator" desc="Check FHIR server response code">
      <input name="actualnumber">$forward_to_fhir{response}{status}</input>
      <input name="expectednumber">"201"</input>
    </verify>

  </steps>

  <output>
    <success>
      <default>"FHIR Patient Create test succeeded."</default>
    </success>
    <failure>
      <default>"FHIR Patient Create test failed. See logs for details."</default>
    </failure>
  </output>

</testcase>
